<!DOCTYPE html>
<html lang="en"><head>
<meta http-equiv="content-type" content="text/html; charset=UTF-8">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Certificate Verification</title>
  <style>
    :root {
      --bg: #f4f6f8;
      --card: #ffffff;
      --text: #1f2933;
      --muted: #52606d;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #121820;
        --card: #1c2530;
        --text: #e6edf3;
        --muted: #9fb0c0;
      }
    }
    body {
      margin: 0;
      padding: 24px 16px;
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    #card {
      max-width: 460px;
      margin: 0 auto;
      padding: 24px;
      background: var(--card);
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    }
    h1 { font-size: 1.2rem; margin: 0 0 16px; }
    #badge {
      display: inline-block;
      margin: 0 0 12px;
      padding: 8px 16px;
      border-radius: 999px;
      font-weight: 700;
      letter-spacing: 0.05em;
      background: #6b7785;
      color: #ffffff;
    }
    #badge.valid { background: #1a7f4b; }
    #badge.revoked { background: #b45309; }
    #badge.tampered { background: #b91c1c; }
    #badge.not_found, #badge.error { background: #6b7785; }
    #message { margin: 0 0 16px; line-height: 1.5; }
    dt { color: var(--muted); font-size: 0.85rem; margin-top: 12px; }
    dd { margin: 2px 0 0; font-weight: 600; }
  </style>
</head>

<body>
  <main id="card">
    <h1>Certificate Verification</h1>
    <p id="badge" class="not_found">NOT FOUND</p>
    <p id="message">No certificate exists with this ID.</p>
    <dl id="details"></dl>
  </main>
  <script>
    const publicId = window.location.pathname.split("/").pop();
    const badge = document.getElementById("badge");
    const message = document.getElementById("message");

    function show(kind, label, text) {
      badge.textContent = label;
      badge.className = kind;
      message.textContent = text;
    }
    function showDetails(data) {
      const details = document.getElementById("details");
      details.replaceChildren();
      if (!data.holder_name) return;

      const rows = [
        ["Holder", data.holder_name],
        ["Course", data.course_name],
        ["Issued on", data.issue_date],
      ];
      for (const [label, value] of rows) {
        const dt = document.createElement("dt");
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.textContent = value;
        details.append(dt, dd);
      }
    }

    async function checkCertificate() {
      try {
        const response = await fetch("/verify/" + encodeURIComponent(publicId));
        if (response.status === 404) {
          show("not_found", "NOT FOUND", "No certificate exists with this ID.");
          return;
        }
        const data = await response.json();
        show(data.result, data.result.toUpperCase(), data.message);
        showDetails(data);
      } catch (error) {
        show("error", "ERROR", "Could not reach the server. Please try again.");
      }
    }

    checkCertificate();
  </script>



</body></html>